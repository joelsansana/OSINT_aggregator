# Telegram API credentials (https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash

# LLM provider for daily digest summaries.
# Pick the preset that matches where your API key is issued:
#   openai  → https://api.openai.com/v1              (default model: gpt-4o-mini)
#   minimax → https://api.minimax.io/v1              (default model: MiniMax-M3)
#   glm     → https://open.bigmodel.cn/api/paas/v4/ (default model: glm-4-flash)
# Override any of these per-provider with LLM_BASE_URL / LLM_MODEL.
LLM_PROVIDER=openai
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY / OPENAI_MODEL still work as legacy fallbacks.

# Output channels
OUTPUT_CHANNEL=your_channel_username
MANUAL_REVIEW=true
REVIEW_CHANNEL=your_private_review_channel

# Local session file name (writes aggregator.session next to the bot)
SESSION_NAME=aggregator

# Polling cadence (seconds)
TELEGRAM_POLL_INTERVAL=60
RSS_POLL_INTERVAL=300
MESSAGES_PER_CHANNEL=5

# Digest job (cron-style). Default: every day at 09:00 UTC.
DIGEST_HOUR_UTC=9
DIGEST_MINUTE_UTC=0
